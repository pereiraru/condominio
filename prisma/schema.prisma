generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Users (admin and residents)
model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String
  name                   String?
  role                   String    @default("user") // "admin" or "user"
  unitId                 String?   @unique // 1:1 with unit
  unit                   Unit?     @relation(fields: [unitId], references: [id])
  ownerId                String?
  owner                  Owner?    @relation(fields: [ownerId], references: [id])
  mustChangePassword     Boolean   @default(false)
  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?
  lastLogin              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

// Building units (apartments)
model Unit {
  id           String        @id @default(cuid())
  code         String        @unique // e.g., "1D", "1E", "2D", "RCE", "CV"
  floor        Int?
  description  String?
  monthlyFee      Float         @default(45.0)
  previousBalance Float         @default(0) // Pre-2024 balance (positive = credit, negative = debt)
  nib             String?
  telefone     String?
  email        String?
  user                User?
  owners              Owner[]
  transactions        Transaction[]
  feeHistory          FeeHistory[]
  extraCharges        ExtraCharge[]
  descriptionMappings DescriptionMapping[]
  incidents           Incident[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

// Unit owners/residents (multiple per unit, with ownership periods)
model Owner {
  id         String   @id @default(cuid())
  name       String
  email      String?
  telefone   String?
  nib        String?
  startMonth String?  // "YYYY-MM" - null = from the beginning
  endMonth   String?  // "YYYY-MM" - null = current owner
  previousDebt Float    @default(0)
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  users      User[]
  createdAt  DateTime @default(now())
}

// Creditors (suppliers, service providers)
model Creditor {
  id          String               @id @default(cuid())
  name        String
  description String?
  category    String               // "electricity", "water", "gas", "maintenance", "insurance", "cleaning", "other"
  amountDue   Float?               // expected regular amount
  isFixed     Boolean              @default(false)
  email       String?
  telefone    String?
  nib         String?
  attachments         CreditorAttachment[]
  transactions        Transaction[]
  feeHistory          FeeHistory[]
  descriptionMappings DescriptionMapping[]
  supplierInvoices    SupplierInvoice[]
  discrepancyResolutions CreditorDiscrepancyResolution[]
  incidents           Incident[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

// Creditor attachments (invoices, contracts)
model CreditorAttachment {
  id         String   @id @default(cuid())
  creditorId String
  creditor   Creditor @relation(fields: [creditorId], references: [id], onDelete: Cascade)
  name       String
  filename   String
  mimeType   String
  size       Int
  uploadedAt DateTime @default(now())
}

// Financial transactions (expenses and payments)
model Transaction {
  id               String             @id @default(cuid())
  date             DateTime
  valueDate        DateTime?
  description      String
  amount           Float              // positive = income, negative = expense
  balance          Float?
  type             String             // "payment", "expense", "fee", "transfer"
  category         String?            // "electricity", "maintenance", "bank_fee", "savings", etc.
  referenceMonth   String?            // "YYYY-MM" - legacy, kept for compatibility
  unitId           String?
  unit             Unit?              @relation(fields: [unitId], references: [id])
  creditorId       String?
  creditor         Creditor?          @relation(fields: [creditorId], references: [id])
  documentId       String?
  document         Document?          @relation(fields: [documentId], references: [id])
  monthAllocations TransactionMonth[]
  supplierInvoices SupplierInvoice[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

// Month allocations for transactions (split a single transaction across multiple months)
model TransactionMonth {
  id            String       @id @default(cuid())
  transactionId String
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  month         String       // "YYYY-MM"
  amount        Float        // amount allocated to this month
  extraChargeId String?      // null = base fee, non-null = extra charge payment
  extraCharge   ExtraCharge? @relation(fields: [extraChargeId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
}

// Documents (invoices, receipts, minutes, convocations)
model Document {
  id                  String         @id @default(cuid())
  name                String
  filename            String
  mimeType            String
  size                Int
  category            String         // "invoice", "receipt", "minutes", "convocation", "contract", "other"
  description         String?
  transactions        Transaction[]
  convocationMeetings CondoMeeting[] @relation("ConvocationDocument")
  uploadedAt          DateTime       @default(now())
}

// Description pattern mapping for auto-assigning transactions
model DescriptionMapping {
  id         String   @id @default(cuid())
  pattern    String   @unique // substring to match in transaction descriptions
  unitId     String?
  creditorId String?
  createdAt  DateTime @default(now())

  unit     Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  creditor Creditor? @relation(fields: [creditorId], references: [id], onDelete: Cascade)
}

// Fee history - tracks fee changes with effective dates
model FeeHistory {
  id            String    @id @default(cuid())
  unitId        String?
  creditorId    String?
  amount        Float
  effectiveFrom String    // "YYYY-MM" format
  effectiveTo   String?   // "YYYY-MM" format, null means ongoing
  createdAt     DateTime  @default(now())

  unit     Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  creditor Creditor? @relation(fields: [creditorId], references: [id], onDelete: Cascade)
}

// Extra charges - additional fees for specific periods (repairs, improvements, etc.)
model ExtraCharge {
  id            String    @id @default(cuid())
  unitId        String?   // null means applies to all units
  description   String    // e.g., "Reparação bomba de água"
  amount        Float     // extra amount to add to monthly fee
  effectiveFrom String    // "YYYY-MM" format
  effectiveTo   String?   // "YYYY-MM" format, null means ongoing
  createdAt     DateTime  @default(now())

  unit              Unit?              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  transactionMonths TransactionMonth[]
}

// Bank accounts (Caixa, Depósitos à Ordem, Depósito a Prazo)
model BankAccount {
  id          String                @id @default(cuid())
  name        String                // "Caixa", "Depósitos à Ordem", "Depósito a Prazo"
  accountType String                // "cash", "current", "savings"
  description String?
  snapshots   BankAccountSnapshot[]
  createdAt   DateTime              @default(now())
}

// Bank account balance snapshots (period-end balances)
model BankAccountSnapshot {
  id            String      @id @default(cuid())
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  date          DateTime    // Snapshot date (e.g., 2025-12-31)
  balance       Float
  description   String?     // Optional note
  createdAt     DateTime    @default(now())
}

// Supplier invoices (tracks paid/unpaid status for annual report)
model SupplierInvoice {
  id            String       @id @default(cuid())
  invoiceNumber String?      // Document number
  entryNumber   String?      // Entry/ledger number
  date          DateTime
  creditorId    String
  creditor      Creditor     @relation(fields: [creditorId], references: [id], onDelete: Cascade)
  description   String
  category      String       // Expense category
  amountDue     Float        // Total invoice amount
  amountPaid    Float        @default(0)
  isPaid        Boolean      @default(false)
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  incidents     Incident[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// Annual budget
model Budget {
  id        String       @id @default(cuid())
  year      Int          @unique
  notes     String?
  lines     BudgetLine[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// Budget line items
model BudgetLine {
  id            String @id @default(cuid())
  budgetId      String
  budget        Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category      String
  description   String
  monthlyAmount Float
  annualAmount  Float
  percentage    Float?
  sortOrder     Int    @default(0)
}

// Creditor discrepancy verification & resolution audit trail
model CreditorDiscrepancyResolution {
  id             String    @id @default(cuid())
  creditorId     String
  creditor       Creditor  @relation(fields: [creditorId], references: [id], onDelete: Cascade)
  discrepancyKey String    @unique
  type           String    // "unreconciled_invoice" | "unpaid_invoice" | "amount_mismatch" | "allocation_mismatch"
  title          String
  description    String
  suggestedFix   String
  resolved       Boolean   @default(true)
  resolvedAt     DateTime?
  resolvedBy     String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Building incident / anomaly management (simplified ITIL)
model Incident {
  id                String               @id @default(cuid())
  code              String               @unique // e.g., "INC-2026-001"
  title             String
  description       String
  immediateAction   String?
  location          String               @default("other") // "elevator" | "garage" | "lighting" | "door" | "water" | "roof" | "cleaning" | "other"
  priority          String               @default("normal") // "low" | "normal" | "urgent"
  visibility        String               @default("public") // "public" | "unit_private"
  status            String               @default("open") // "open" | "in_progress" | "scheduled" | "resolved" | "closed"
  reportedByUnitId  String?
  reportedByUnit    Unit?                @relation(fields: [reportedByUnitId], references: [id], onDelete: SetNull)
  reportedByName    String
  reportedByEmail   String?
  notifyEmails      String?              // Comma-separated personal notification emails
  reportedAt        DateTime             @default(now())
  assignedTo        String?
  plannedDate       DateTime?
  resolvedAt        DateTime?
  resolutionNotes   String?
  expenseAmount     Float?
  creditorId        String?
  creditor          Creditor?            @relation(fields: [creditorId], references: [id], onDelete: SetNull)
  supplierInvoiceId String?
  supplierInvoice   SupplierInvoice?     @relation(fields: [supplierInvoiceId], references: [id], onDelete: SetNull)
  attachments       IncidentAttachment[]
  logs              IncidentLog[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model IncidentAttachment {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  phase      String   @default("report") // "report" | "resolution"
  name       String
  filename   String
  mimeType   String
  size       Int
  uploadedAt DateTime @default(now())
}

model IncidentLog {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actorName  String
  actorRole  String   @default("user") // "admin" | "user" | "system"
  actionType String   // "created" | "status_change" | "assignment" | "comment" | "resolution" | "attachment"
  message    String
  createdAt  DateTime @default(now())
}

model NotificationConfig {
  id          String   @id @default("default")
  enabled     Boolean  @default(false)
  adminEmails String?  // Comma-separated emails for administration alerts
  smtpHost    String?
  smtpPort    Int?     @default(587)
  smtpSecure  Boolean  @default(false)
  smtpUser    String?
  smtpPass    String?
  fromName    String?  @default("Condomínio Rua Vieira da Silva, 6")
  fromEmail   String?
  updatedAt   DateTime @updatedAt
}

// Condominium assembly meetings & minutes (Convocatória / Ata)
model CondoMeeting {
  id                   String    @id @default(cuid())
  year                 Int
  actaNumber           String    @default("24")
  assemblyType         String    @default("Ordinária") // "Ordinária" | "Extraordinária"
  meetingDate          String    // "YYYY-MM-DD"
  startTime            String    @default("22:00")
  endTime              String?   // "HH:mm"
  convocationUsed      String    @default("2.ª") // "1.ª" | "2.ª"
  location             String    @default("Parqueamento situado no Piso -4 do Edifício")
  presidedBy           String    @default("Administração Cessante")
  secretaryBy          String    @default("A designar na reunião")
  newAdminNames        String?
  status               String    @default("draft") // "draft" | "finalized"
  quorumMode           String    @default("units") // "units" | "permilagem"
  firstConvocationTime String    @default("21:30") // Hora 1.ª convocatória
  issueDate            String?   // Data de emissão da convocatória ("YYYY-MM-DD")
  extraNote            String?   // Nota adicional da convocatória
  adminSigners           String?   // Assinatura / Administração na convocatória
  convocationSentAt      DateTime? // Último envio da convocatória por email
  convocationStatus      String    @default("draft") // "draft" | "finalized"
  convocationFinalizedAt DateTime?
  convocationDocumentId  String?
  convocationDocument    Document? @relation("ConvocationDocument", fields: [convocationDocumentId], references: [id], onDelete: SetNull)
  attendanceJson         String    @default("{}")
  discussionPointsJson String    @default("[]")
  actionItemsJson      String    @default("[]")
  generalNotes         String?
  generatedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}
